<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Raw District | Modern Clothing</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #111;
      color: #fff;
      margin: 0;
      padding: 0;
    }
    header {
      background: #000;
      padding: 15px;
      text-align: center;
      border-bottom: 2px solid #444;
    }
    header img {
      max-height: 80px;
    }
    nav {
      margin-top: 10px;
    }
    nav a {
      margin: 0 10px;
      text-decoration: none;
      color: #f04;
      font-weight: bold;
    }
    .products {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
      padding: 20px;
    }
    .product {
      background: #222;
      padding: 15px;
      border-radius: 8px;
      text-align: center;
    }
    .product img {
      max-width: 100%;
      border-radius: 5px;
    }
    .btn {
      display: inline-block;
      margin-top: 10px;
      padding: 10px 15px;
      background: #f04;
      color: #fff;
      border: none;
      cursor: pointer;
      border-radius: 5px;
    }
    .btn:hover { background: #d03; }

    /* Carrito */
    #cart {
      position: fixed;
      top: 0;
      right: -400px;
      width: 350px;
      height: 100%;
      background: #000;
      border-left: 2px solid #444;
      padding: 20px;
      overflow-y: auto;
      transition: 0.4s;
      z-index: 1000;
    }
    #cart.active { right: 0; }
    #cart h2 { margin-top: 0; }
    .cart-item {
      border-bottom: 1px solid #444;
      padding: 10px 0;
    }
    .cart-item p { margin: 5px 0; }
    .cart-total {
      margin-top: 20px;
      font-weight: bold;
      font-size: 1.2rem;
    }
    .checkout-btn {
      margin-top: 15px;
      width: 100%;
      padding: 10px;
      background: #f04;
      border: none;
      color: #fff;
      cursor: pointer;
      border-radius: 5px;
    }

    /* Botón flotante WhatsApp */
    .whatsapp-float {
      position: fixed;
      width: 60px;
      height: 60px;
      bottom: 20px;
      right: 20px;
      background: #25D366;
      color: #fff;
      border-radius: 50%;
      text-align: center;
      font-size: 30px;
      box-shadow: 2px 2px 10px rgba(0,0,0,0.3);
      z-index: 1001;
      display: flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
    }
    .whatsapp-float:hover {
      background: #20b954;
    }
  </style>
</head>
<body>

<header>
  <img src="9C07D622-1C44-4BF9-92D9-392931C1BAC4.jpeg" alt="Raw District Logo">
  <nav>
    <a href="#coleccion">Colección</a>
    <a href="javascript:void(0)" onclick="toggleCart()">🛒 Carrito</a>
  </nav>
</header>

<section class="products" id="coleccion">
  <div class="product">
    <img src="https://images.unsplash.com/photo-1602810318383-e6e69a642d9a?auto=format&fit=crop&w=600&q=80" alt="Camiseta">
    <h3>Camiseta Raw District</h3>
    <p>25 €</p>
    <button class="btn" onclick="addToCart('Camiseta Raw District', 25)">Añadir al carrito</button>
  </div>
  <div class="product">
    <img src="https://images.unsplash.com/photo-1526170375885-4d8ecf77b99f?auto=format&fit=crop&w=600&q=80" alt="Sudadera">
    <h3>Sudadera Oversize</h3>
    <p>45 €</p>
    <button class="btn" onclick="addToCart('Sudadera Oversize', 45)">Añadir al carrito</button>
  </div>
  <div class="product">
    <img src="https://images.unsplash.com/photo-1620799139504-3b9d2955e7dc?auto=format&fit=crop&w=600&q=80" alt="Gorra">
    <h3>Gorra Street</h3>
    <p>15 €</p>
    <button class="btn" onclick="addToCart('Gorra Street', 15)">Añadir al carrito</button>
  </div>
</section>

<!-- Carrito -->
<div id="cart">
  <h2>🛒 Carrito</h2>
  <div id="cart-items"></div>
  <p class="cart-total">Total: 0 €</p>
  <button class="checkout-btn" onclick="checkout()">Finalizar Compra</button>
</div>

<!-- Botón flotante WhatsApp -->
<a href="https://wa.me/34655080157?text=Hola!%20Quiero%20más%20información%20sobre%20Raw%20District" 
   class="whatsapp-float" target="_blank">
   💬
</a>

<script>
  let cart = [];
  const phoneNumber = "34655080157"; // tu número en WhatsApp

  function toggleCart() {
    document.getElementById('cart').classList.toggle('active');
  }

  function addToCart(product, price) {
    cart.push({product, price});
    renderCart();
  }

  function renderCart() {
    const cartItems = document.getElementById('cart-items');
    cartItems.innerHTML = '';
    let total = 0;
    cart.forEach((item, index) => {
      total += item.price;
      cartItems.innerHTML += `
        <div class="cart-item">
          <p>${item.product} - ${item.price} €</p>
          <button class="btn" style="background:#444" onclick="removeItem(${index})">Eliminar</button>
        </div>
      `;
    });
    document.querySelector('.cart-total').innerText = 'Total: ' + total + ' €';
  }

  function removeItem(index) {
    cart.splice(index, 1);
    renderCart();
  }

  function checkout() {
    if (cart.length === 0) {
      alert("Tu carrito está vacío.");
      return;
    }
    let total = cart.reduce((acc, item) => acc + item.price, 0);
    let message = "Hola! Quiero hacer un pedido en *Raw District*:%0A%0A";
    cart.forEach(item => {
      message += "- " + item.product + " (" + item.price + " €)%0A";
    });
    message += "%0ATotal: " + total + " €";
    window.open(`https://wa.me/${phoneNumber}?text=${message}`, "_blank");
  }
</script>

</body>
</html>
